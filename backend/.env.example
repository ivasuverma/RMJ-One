# Copy this file to .env and fill in real values before running the backend.

# MongoDB connection. For local testing, the easiest option is Docker:
#   docker run -d --name rmj-mongo -p 27017:27017 mongo:7
# then use: mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
DB_NAME=rmj_one

# Optional — only used to sign auth tokens. Fine to leave as-is for local testing.
# In production (ENVIRONMENT=production below), the backend refuses to start
# if this is still the default value.
JWT_SECRET=rmj-one-dev-secret-change-in-prod

# Set to "production" on the deployed server. Together with JWT_SECRET above,
# this is what makes the backend refuse to boot with the default dev secret.
ENVIRONMENT=development

# Comma-separated list of origins allowed to call this API, e.g.
#   ALLOWED_ORIGINS=https://app.ramjewellers.in
# Defaults to "*" (any origin) if unset — fine for local dev, but set this
# explicitly in production.
ALLOWED_ORIGINS=*

# Optional — only required for the "Ask AI" assistant screen (app/assistant.tsx).
# Without it, everything else (dashboard, attendance, payroll, employees) works fine;
# the assistant screen will just show "AI library unavailable" / "not configured".
EMERGENT_LLM_KEY=

# Optional — only required for browser push notifications (Settings > Notifications).
# Without these, everything else works fine; push just stays disabled.
# Generate a pair with: python generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Required for Google Drive (Documents module, Record Photos, and the nightly
# whole-DB backup all share this one OAuth connection — see drive_service.py).
# From a Google Cloud OAuth client (Settings > Google Drive & Backup walks
# through creating one). Without these three, Drive can never be connected —
# Documents/backup fail immediately, not just when the token expires.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Required for WhatsApp (repair notices, gold rate broadcast, the RATE/STATUS
# chatbot) — points at the self-hosted OpenWA gateway (see E:\OpenWA on the
# shop's server; a fresh install needs that service running and its own .env
# configured too, not just these three lines). Left unset, WhatsApp silently
# stays disabled rather than erroring — everything else still works.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_NAME=main

# Required to verify OpenWA's inbound webhook signature (X-OpenWA-Signature).
# Left unset, that check is effectively defeated — set this to a random
# string and configure the SAME value on the OpenWA side.
WHATSAPP_WEBHOOK_SECRET=

# Optional — the daily gold/silver rate scrape (see gold_rate.py) and the
# WhatsApp Channel it can broadcast to. Sensible defaults are hardcoded, so
# these only need setting if the shop uses a different supplier page or
# Channel.
GOLD_RATE_CHANNEL_ID=
GOLD_RATE_SOURCE_URL=
GOLD_RATE_ROW_LABEL=
GOLD_RATE_SILVER_LABEL=
